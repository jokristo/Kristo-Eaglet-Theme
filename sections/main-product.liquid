{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign size_chart = product.metafields.custom.size_chart.value
-%}

<div class="page-width">
  <div class="product">
    <div class="product__gallery" data-gallery>
      <div class="product__gallery-main">
        <img
          src="{{ current_variant.featured_image | default: product.featured_image | image_url: width: 1100 }}"
          alt="{{ product.featured_image.alt | escape }}"
          width="1100"
          height="1375"
          loading="eager"
          data-gallery-main
        >
      </div>

      {%- if product.images.size > 1 -%}
        <div class="product__thumbs" role="list">
          {%- for image in product.images limit: 8 -%}
            <button
              type="button"
              class="product__thumb{% if forloop.first %} is-active{% endif %}"
              data-gallery-thumb
              data-full="{{ image | image_url: width: 1100 }}"
              aria-label="{{ 'products.product.view_image' | t }} {{ forloop.index }}"
            >
              <img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt | escape }}" loading="lazy" width="200" height="250">
            </button>
          {%- endfor -%}
        </div>
        {%- if product.images.size > 8 -%}
          <p class="product__thumbs-note">{{ 'products.product.more_images' | t: count: product.images.size }}</p>
        {%- endif -%}
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- if product.vendor != blank -%}
        <p class="product__vendor">{{ product.vendor }}</p>
      {%- endif -%}

      <h1>{{ product.title }}</h1>

      <p class="product__price" data-product-price>{{ current_variant.price | money }}</p>

      {% form 'product', product, class: 'product__form', id: 'ProductForm' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- liquid
              assign option_handle = option.name | handle
              assign is_color = false
              if option_handle contains 'color' or option_handle contains 'colour'
                assign is_color = true
              endif
            -%}
            <fieldset class="product__option" data-option-position="{{ option.position }}">
              <legend class="product__option-label">
                <span>{{ option.name }}</span>
                <span class="product__option-value" data-option-selected="{{ option.position }}">{{ option.selected_value }}</span>
              </legend>

              <div class="product__swatches{% if is_color %} product__swatches--color{% endif %}">
                {%- for value in option.values -%}
                  {%- assign input_id = section.id | append: '-opt' | append: option.position | append: '-' | append: forloop.index -%}
                  <input
                    type="radio"
                    class="product__swatch-input"
                    id="{{ input_id }}"
                    name="option-{{ option.position }}"
                    value="{{ value | escape }}"
                    data-option-input
                    data-option-position="{{ option.position }}"
                    {% if value == option.selected_value %}checked{% endif %}
                  >
                  <label
                    class="product__swatch{% if is_color %} product__swatch--color{% endif %}"
                    for="{{ input_id }}"
                    {% if is_color %}title="{{ value | escape }}" data-swatch-color="{{ value | handle }}"{% endif %}
                  >
                    {%- if is_color -%}
                      <span class="visually-hidden">{{ value }}</span>
                    {%- else -%}
                      {{ value }}
                    {%- endif -%}
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}

          {%- if size_chart != blank -%}
            <button type="button" class="product__size-link" data-size-guide-open>
              {{ 'products.product.size_guide' | t }}
            </button>
          {%- endif -%}
        {%- endunless -%}

        <label for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
        <input
          class="qty-input"
          type="number"
          id="Quantity-{{ section.id }}"
          name="quantity"
          min="1"
          value="1"
        >

        <button
          type="submit"
          class="btn"
          data-buy-button
          data-text-add="{{ 'products.product.add_to_cart' | t }}"
          data-text-added="{{ 'products.product.added' | t }}"
          data-text-sold-out="{{ 'products.product.sold_out' | t }}"
          data-text-unavailable="{{ 'products.product.unavailable' | t }}"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          {%- if current_variant.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </button>
      {% endform %}

      {%- if section.settings.shipping_note != blank -%}
        <p class="product__reassurance">{{ section.settings.shipping_note }}</p>
      {%- endif -%}

      <div class="product__description rte">
        {{ product.description }}
      </div>
    </div>
  </div>
</div>

{%- comment -%} Barre d'achat collante — mobile uniquement {%- endcomment -%}
<div class="buy-bar" data-buy-bar hidden>
  <div class="buy-bar__inner page-width">
    <img
      class="buy-bar__thumb"
      src="{{ product.featured_image | image_url: width: 120 }}"
      alt=""
      width="120"
      height="150"
      loading="lazy"
      data-buy-bar-image
    >
    <div class="buy-bar__text">
      <span class="buy-bar__title">{{ product.title | truncate: 42 }}</span>
      <span class="buy-bar__price" data-buy-bar-price>{{ current_variant.price | money }}</span>
    </div>
    <button type="button" class="btn buy-bar__btn" data-buy-bar-button>
      {{ 'products.product.add_to_cart' | t }}
    </button>
  </div>
</div>

{%- if size_chart != blank -%}
  <div class="size-modal" data-size-guide hidden>
    <div class="size-modal__backdrop" data-size-guide-close></div>
    <div class="size-modal__panel" role="dialog" aria-modal="true" aria-label="{{ 'products.product.size_guide' | t }}">
      <button type="button" class="size-modal__close" data-size-guide-close aria-label="{{ 'general.close' | t }}">&times;</button>
      <h2>{{ 'products.product.size_guide' | t }}</h2>
      <div class="size-modal__body rte">{{ size_chart }}</div>
    </div>
  </div>
{%- endif -%}

<script type="application/json" data-product-json>
  {{ product | json }}
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "textarea",
      "id": "shipping_note",
      "label": "Note livraison / retours",
      "default": "Imprimé sur commande — expédié sous 3-5 jours ouvrés, livré en 7-12 jours. Retours acceptés sous 30 jours."
    }
  ]
}
{% endschema %}
